# Local runtime state. The application recreates this directory on startup.
data/*
!data/.gitkeep

# .env is read at startup and holds machine-local secrets, so it must never be committed;
# .env.* variants are not read by the platform and stay ignored for the same reason.
.env
.env.*
!.env.example

node_modules/
.venv/
coverage/
*.log
artifacts/
test-results/
*.tmp

# Generated semantic-eval output (baseline.json is committed on purpose).
eval/report.json
