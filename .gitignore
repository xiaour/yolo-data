# Local runtime state. The application recreates this directory on startup.
data/*
!data/.gitkeep

# Local secrets and environment overrides.
.env
.env.*
!.env.example

node_modules/
coverage/
*.log
artifacts/
test-results/
*.tmp

# Generated semantic-eval output (baseline.json is committed on purpose).
eval/report.json

# Local-only CI config: these workflows are not published to the remote repo.
.github/workflows/
