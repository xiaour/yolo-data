# Local runtime state. The application recreates this directory on startup.
data/*
!data/.gitkeep

# Legacy dotenv files. The platform no longer reads them (config lives in yolo-conf.yaml);
# kept ignored so a leftover file with real credentials can never be committed by accident.
.env
.env.*
!.env.example

node_modules/
.venv/
coverage/
*.log
artifacts/
test-results/
*.tmp

# Generated semantic-eval output (baseline.json is committed on purpose).
eval/report.json
