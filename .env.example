# YOLO 服务端口
PORT=8088

# 模型服务，可按需替换为任意 OpenAI-compatible 服务
DEEPSEEK_API_KEY=replace_with_your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOOL_ROUNDS=12

# 外部指标平台（可选）
SUPERSONIC_BASE_URL=http://supersonic.example.com/
SUPERSONIC_TOKEN=replace_with_your_token
SUPERSONIC_SERVICE_CLIENT_ID=yolo
SUPERSONIC_SERVICE_CLIENT_SECRET=replace_with_your_client_secret

# 可选的首启业务数据源引导
DORIS_BOOTSTRAP_ENABLED=false
DORIS_BOOTSTRAP_HOST=
DORIS_BOOTSTRAP_PORT=9030
DORIS_BOOTSTRAP_USER=
DORIS_BOOTSTRAP_PASSWORD=
DORIS_BOOTSTRAP_DATABASE=
DORIS_BOOTSTRAP_SALES_TABLE=
DORIS_BOOTSTRAP_GOODS_TABLE=
