# Copy to .env for machine-local settings. .env is ignored by Git.
# Process environment variables override .env; .env overrides yolo-conf.yaml.

PLATFORM_DB_BACKEND=mysql
PLATFORM_DB_HOST=
PLATFORM_DB_PORT=3306
PLATFORM_DB_NAME=
PLATFORM_DB_USER=
PLATFORM_DB_PASSWORD=

API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
API_KEY=
MODEL=GLM-4.7-Flash

# Codex planning runtime is enabled by default and does not require codex login.
AGENT_COMPUTE_MODE=auto
CODEX_RUNTIME_ENABLED=true
CODEX_COMMAND=
CODEX_PROVIDER=ollama
CODEX_PROVIDER_BASE_URL=
CODEX_PROVIDER_API_KEY=
CODEX_WIRE_API=responses
CODEX_MODEL=gpt-oss:20b
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT_MS=300000
CODEX_WORKING_DIRECTORY=./data/codex-runtime

# Optional per-source connection overrides. Replace PLATFORM_MYSQL with the
# uppercase data-source code, with non-alphanumeric characters changed to _.
DATASOURCE_PLATFORM_MYSQL_HOST=
DATASOURCE_PLATFORM_MYSQL_PORT=
DATASOURCE_PLATFORM_MYSQL_DATABASE=
DATASOURCE_PLATFORM_MYSQL_USER=
DATASOURCE_PLATFORM_MYSQL_PASSWORD=
