# YOLO 服务端口
PORT=8088

# 登录与会话。生产环境（NODE_ENV=production）默认强制登录；
# 本地开发保持 dev 模式时可用 x-user-id 直连，方便脚本调试。
AUTH_MODE=
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=
# 初始化内置用户时写入的默认口令（留空则使用 yolo123456）
DEFAULT_USER_PASSWORD=

# 模型服务，可按需替换为任意 OpenAI-compatible 服务。
# 保持为空时使用本地规则降级（local-rule），无需任何外部服务即可启动预览；
# 只有填了非空的 DEEPSEEK_API_KEY，平台才会切换到真实大模型调用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOOL_ROUNDS=12

# 外部指标平台（可选）。保持为空时指标目录标记为 UNAVAILABLE，
# 平台不进行指标查询；填写后须同时配置 TOKEN。
SUPERSONIC_BASE_URL=
SUPERSONIC_TOKEN=
SUPERSONIC_SERVICE_CLIENT_ID=yolo
SUPERSONIC_SERVICE_CLIENT_SECRET=

# 本地文件分析（问数时结合用户上传的 Excel/CSV 做计算）。
# 受限执行环境（防误操作，不是安全边界）用于执行生成的算数脚本；
# 留空时按平台兜底 python3（Windows 为 python），`npm run setup` 会探测并写回可用解释器；
# 生成 `.xlsx` 还需要该解释器安装 pandas 与 openpyxl。
PYTHON_BIN=python3
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES_PER_SESSION=20
UPLOAD_MAX_TOTAL_BYTES_PER_SESSION=41943040
UPLOAD_ALLOWED_EXTENSIONS=csv,xls,xlsx

# 可选的首启业务数据源引导
DORIS_BOOTSTRAP_ENABLED=false
DORIS_BOOTSTRAP_HOST=
DORIS_BOOTSTRAP_PORT=9030
DORIS_BOOTSTRAP_USER=
DORIS_BOOTSTRAP_PASSWORD=
DORIS_BOOTSTRAP_DATABASE=
DORIS_BOOTSTRAP_SALES_TABLE=
DORIS_BOOTSTRAP_GOODS_TABLE=

# 长期记忆的自动整理（可选）
# 攒够多少条笔记自动合并进记忆文档
USER_MEMORY_AUTO_CONSOLIDATE_AT=8
# 记忆文档正文达到内容预算的多少比例时自动压缩（0.2-1）
USER_MEMORY_COMPACT_RATIO=0.8
# 后台巡检间隔毫秒，0 表示关闭巡检（只保留每轮问答后的顺带整理）
USER_MEMORY_MAINTENANCE_INTERVAL_MS=900000
# 首个巡检周期前的等待毫秒
USER_MEMORY_MAINTENANCE_STARTUP_DELAY_MS=60000
# 单次巡检最多处理多少个作用域
USER_MEMORY_MAINTENANCE_BATCH_SIZE=20
