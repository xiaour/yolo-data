{
  "name": "yolo-data",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "YOLO Data intelligent query platform",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:init": "node scripts/init-platform-db.mjs",
